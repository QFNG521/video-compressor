{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "轻压",
  "version": "0.1.1",
  "identifier": "com.lvruifeng.mediacompressor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "轻压 · 本地视频/图片压缩工具",
        "width": 860,
        "height": 780,
        "minWidth": 660,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["ffmpeg"]
  },
  "plugins": {}
}
